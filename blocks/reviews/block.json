{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "if-reviews/reviews",
	"version": "2.2.0",
	"title": "Reviews",
	"category": "widgets",
	"icon": "star-filled",
	"description": "Your customer reviews as a grid, list or carousel, with an honest summary header. Settings left at \"Default\" follow Reviews → Display Settings.",
	"keywords": [ "reviews", "testimonials", "rating", "stars" ],
	"textdomain": "if-reviews",
	"attributes": {
		"layout": { "type": "string", "default": "" },
		"columns": { "type": "number", "default": 0 },
		"limit": { "type": "number", "default": -1 },
		"showMore": { "type": "string", "default": "" },
		"order": { "type": "string", "default": "" },
		"source": { "type": "string", "default": "" },
		"showHeader": { "type": "string", "default": "" },
		"title": { "type": "string", "default": "" },
		"showButtons": { "type": "string", "default": "" }
	},
	"supports": {
		"align": [ "wide", "full" ],
		"anchor": true,
		"html": false
	},
	"editorScript": "file:./block.js",
	"style": "if-reviews-style"
}
