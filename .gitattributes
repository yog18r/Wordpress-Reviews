# Consistent line endings in the repository.
* text=auto eol=lf
*.php text eol=lf
*.css text eol=lf
*.js text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf

# Binary translation catalogues.
*.mo binary
*.png binary
*.jpg binary

# Keep repository-only files out of GitHub's source archives (the "Source
# code" downloads on each release). Sites never install these: the update
# checker only uses the if-reviews.zip release asset.
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.distignore export-ignore
/.editorconfig export-ignore
/README.md export-ignore
/assets/screenshots export-ignore
/tests export-ignore
