# Consistent line endings in the repository.
* text=auto eol=lf
*.php text eol=lf
*.css text eol=lf
*.js text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf

# Binary translation catalogues.
*.mo binary
*.png binary
*.jpg binary

# Keep repository-only files out of GitHub's source archives, which the
# update checker falls back to when a release has no zip asset.
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.distignore export-ignore
/.editorconfig export-ignore
/README.md export-ignore
